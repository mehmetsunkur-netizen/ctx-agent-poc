# Search Backend Configuration
# Options: "chroma" (default) or "http"
SEARCH_BACKEND=http

# ChromaDB Configuration (when SEARCH_BACKEND=chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Optional: If authentication is enabled
# CHROMA_AUTH_TOKEN=your-token

# HTTP Search Configuration (when SEARCH_BACKEND=http)
# SEARCH_API_URL=http://localhost:3000
# SEARCH_TIMEOUT_MS=30000

# org-ctx-layer API Configuration
# Required for ChromaDB backend to resolve source groups
# Used to fetch group metadata (e.g., org-data -> slack + notion)
ORG_CTX_LAYER_API_URL=http://localhost:3059

# OpenAI Configuration
OPENAI_API_KEY=your-api-key-here

# Optional: Custom OpenAI endpoint
# OPENAI_BASE_URL=http://localhost:2141/v1

# Default source when --source not specified
# Defaults to "org-data" (non-technical organizational context: slack + notion)
# Options: individual source ("slack", "notion") or group name ("org-data")
DEFAULT_SOURCE=org-data
